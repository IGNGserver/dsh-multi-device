{
  "name": "dsh-multi-device",
  "description": "Multi-device management plugin for DeepSeek Harness (DSH) Desktop & Web: SSH tunnel connections, system SSH config and key reuse, Git remote workspace auto-aggregation, and independent Aggregated + Native dual-mode UI with keep-alive.",
  "version": "0.2.12",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "VERSION",
    "README.md",
    "RELEASE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IGNGserver/dsh-multi-device.git"
  },
  "homepage": "https://github.com/IGNGserver/dsh-multi-device",
  "bugs": {
    "url": "https://github.com/IGNGserver/dsh-multi-device/issues"
  },
  "scripts": {
    "verify:version": "node scripts/verify-version.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run verify:version && pnpm run build && pnpm run test"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.3.0",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
